# ──────────────────────────────────────────────────────────────────────────
# Notion Onboarding — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────

# Notion Internal Integration Token
# Create one at: https://www.notion.so/my-integrations
# Then share each database with the integration via the "Connect to" menu.
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Legacy — kept for backwards compatibility
NOTION_DATABASE_ID=

# Notion database (data source) IDs for each tab
# Find these in the Notion URL when a database is open:
#   notion.so/<workspace>/<THIS-UUID>?v=...
HANDBOOK_DATA_SOURCE_ID=
TECHNICAL_DATA_SOURCE_ID=
TOOLS_DATA_SOURCE_ID=
FUNDING_DATA_SOURCE_ID=
PROJECTS_DATA_SOURCE_ID=
