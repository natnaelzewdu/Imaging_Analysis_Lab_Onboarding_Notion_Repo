# ──────────────────────────────────────────────────────────────────────────
# Notion Onboarding - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
#
# WHERE TO GET THESE VALUES:
# All tokens and IDs are stored in the "Environment Variables" spreadsheet
# inside the Onboarding Resources folder on SharePoint:
#
#   https://studentgsu-my.sharepoint.com/:f:/r/personal/nalemayehu3_student_gsu_edu/Documents/Onboarding%20Resources?csf=1&web=1&e=dvr9zc
#
# You must be granted access to this folder before you can view the file.
# Request access from someone who already has edit permissions on that folder.
# ──────────────────────────────────────────────────────────────────────────

# Notion Internal Integration Token (from the Environment Variables spreadsheet)
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion database (data source) IDs for each tab (from the Environment Variables spreadsheet)
HANDBOOK_DATA_SOURCE_ID=
TECHNICAL_DATA_SOURCE_ID=
TOOLS_DATA_SOURCE_ID=
FUNDING_DATA_SOURCE_ID=
PROJECTS_DATA_SOURCE_ID=

# Plain Notion page IDs (from the Environment Variables spreadsheet)
WELCOME_PAGE_ID=
LAB_LEADERSHIP_PAGE_ID=






